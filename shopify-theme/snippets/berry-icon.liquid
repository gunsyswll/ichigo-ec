{%- comment -%}
  Outline strawberry glyph used in placeholder photo blocks.
  Params: stroke (default light), tone ('soft' uses greige stroke)
{%- endcomment -%}
{%- if tone == 'soft' -%}
<svg class="berry" viewBox="0 0 64 64" fill="none" stroke="rgba(110,98,86,.6)" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg>
{%- else -%}
<svg class="berry" viewBox="0 0 64 64" fill="none" stroke="rgba(255,255,255,.85)" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg>
{%- endif -%}
