{%- comment -%}
  Real product card. Param: product (a Shopify product object).
  Reuses the existing .card / .ph / .card-body design classes.
  ボタンはどれも商品ページへのリンク（カート投入は商品ページ側）。

  ボタン文言（クライアント指定 2026-08-11）:
    在庫あり            → Purchase
    売り切れ            → Reserve（画像には SOLD OUT を重ねる）
    Coming Soon / Pre-order → 商品ページのボタンと同じ文言にそろえる
      （そろえないと、カードで Purchase → 商品ページでは押せない、という食い違いが出る）
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="card-wrap">
{%- if product.available -%}
  <a class="card" href="{{ product.url }}" data-reveal>
    <div class="ph{% unless product.featured_image %} soft{% endunless %}">
      {%- if on_sale -%}<span class="card-tag tag-new">Sale</span>{%- endif -%}
      {%- assign cst = product.metafields.custom.sale_status -%}
      {%- if cst == 'coming_soon' -%}<span class="card-status coming">Coming Soon</span>
      {%- elsif cst == 'preorder' -%}<span class="card-status pre">Pre-order</span>{%- endif -%}
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'card-img', alt: product.title }}
      {%- else -%}
        <svg class="berry" viewBox="0 0 64 64" fill="none" stroke="rgba(110,98,86,.6)" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg>
      {%- endif -%}
    </div>
    <div class="card-body">
      <h3>{{ product.title }}</h3>
      {%- if product.description != blank -%}<p class="desc">{{ product.description | strip_html | truncatewords: 14 }}</p>{%- endif -%}
      <div class="price">
        {{ product.price | money }}
        {%- if on_sale -%}<span class="sm"><s>{{ product.compare_at_price | money }}</s></span>{%- endif -%}
      </div>
      {%- liquid
        assign cta = 'Purchase'
        if cst == 'coming_soon'
          assign cta = 'Coming Soon'
        elsif cst == 'preorder'
          assign cta = 'Pre-order'
        endif
      -%}
      <span class="btn btn-red">{{ cta }}</span>
    </div>
  </a>
{%- else -%}
  <div class="card sold" data-reveal>
    <div class="ph grey">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'card-img', alt: product.title }}
      {%- endif -%}
      <span class="soldflag"><span>SOLD OUT</span></span>
    </div>
    <div class="card-body">
      <h3>{{ product.title }}</h3>
      {%- if product.description != blank -%}<p class="desc">{{ product.description | strip_html | truncatewords: 14 }}</p>{%- endif -%}
      <div class="price">{{ product.price | money }}</div>
      <a class="btn btn-ghost" href="{{ product.url }}">Reserve</a>
    </div>
  </div>
{%- endif -%}
  {%- render 'wishlist-button', product: product, compact: true -%}
</div>
