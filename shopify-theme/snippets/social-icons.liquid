{%- comment -%}
  SNS リンク（Instagram / Facebook）— 1か所で管理するための共通スニペット。

  URL は「テーマ設定 → SNS」の1か所だけで設定する。セクション側の設定があればそれを優先
  （instagram / facebook 引数で渡す）。空ならグローバル設定にフォールバックする。

  引数:
    variant  'nav'（ヘッダーの丸ボタン）| 'footer'（小アイコン）| 'drawer'（モバイルメニュー内）
    instagram, facebook  セクション個別の上書き URL（任意）
    class    追加クラス（任意）
{%- endcomment -%}

{%- liquid
  assign ig = instagram | default: settings.social_instagram_url
  assign fb = facebook  | default: settings.social_facebook_url
  assign v  = variant   | default: 'nav'
  assign icon_size = 16
  assign link_class = ''
  if v == 'nav'
    assign icon_size = 17
    assign link_class = 'icon-btn'
  endif
-%}

{%- if ig != blank or fb != blank -%}
<div class="social-icons social-icons--{{ v }} {{ class }}">
  {%- if ig != blank -%}
  <a class="{{ link_class }}" href="{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram（新しいタブで開きます）" title="Instagram">
    <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    {%- if v == 'drawer' -%}<span>Instagram</span>{%- endif -%}
  </a>
  {%- endif -%}
  {%- if fb != blank -%}
  <a class="{{ link_class }}" href="{{ fb }}" target="_blank" rel="noopener" aria-label="Facebook（新しいタブで開きます）" title="Facebook">
    <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H17V3.6c-.29-.04-1.3-.13-2.47-.13-2.44 0-4.11 1.49-4.11 4.22v2.36H7.7V13h2.72v8z"/></svg>
    {%- if v == 'drawer' -%}<span>Facebook</span>{%- endif -%}
  </a>
  {%- endif -%}
</div>
{%- endif -%}
