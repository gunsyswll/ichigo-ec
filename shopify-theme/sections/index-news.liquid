{%- comment -%}
  News & Events teaser. Pulls the latest posts from the built-in "news" blog
  ({{ blogs.news }}). If the blog has no posts yet, it falls back to clearly
  labelled SAMPLE cards so the homepage never looks broken. "View all →" goes
  to the Shopify blog index. Write real posts in Admin → Blog posts (blog: News).
{%- endcomment -%}
{% render 'news-teaser', eyebrow: section.settings.eyebrow, heading: section.settings.heading,
   subtext: section.settings.subtext, cta_label: section.settings.cta_label %}

{% schema %}
{
  "name": "News & Events",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Latest from Ichigo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "News & Events" },
    { "type": "textarea", "id": "subtext", "label": "Sub text", "default": "Announcements, pop-up events, and seasonal stories." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View all →" }
  ],
  "presets": [
    { "name": "News & Events" }
  ]
}
{% endschema %}
