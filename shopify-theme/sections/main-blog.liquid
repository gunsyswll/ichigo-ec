{%- comment -%}
  Blog index. Lists {{ blog.articles }} as .article-card tiles (featured image,
  tag, date, title, excerpt) in the shared .article-grid, paginated. Matches the
  homepage News section markup so the design carries through.
{%- endcomment -%}
<section class="page-hero">
  <div class="wrap">
    <h1>{{ section.settings.heading | default: blog.title }}</h1>
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
  </div>
</section>

<section style="padding:40px 0 84px">
  <div class="wrap">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="article-grid" data-stagger>
          {%- for article in blog.articles -%}
            <a class="article-card" href="{{ article.url }}" data-reveal>
              <div class="thumb"{% if article.image %} style="padding:0"{% endif %}>
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 640 }}" alt="{{ article.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
                {%- else -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg>
                {%- endif -%}
              </div>
              <div class="article-body">
                <div class="meta">
                  <span class="tag-news">{% if article.tags.size > 0 %}{{ article.tags.first | capitalize }}{% else %}News{% endif %}</span>
                  <span>{{ article.published_at | date: "%b %-d, %Y" }}</span>
                </div>
                <h3>{{ article.title }}</h3>
                <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
                <span class="link">Read more →</span>
              </div>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Prev</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="sec-head"><p>No posts yet. Check back soon.</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "News & Events" },
    { "type": "textarea", "id": "subtext", "label": "Sub text", "default": "Arrival announcements, pop-ups, and seasonal notes from the farms." }
  ]
}
{% endschema %}
