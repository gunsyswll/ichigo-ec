{%- comment -%}
  Live product page. Adapts the page-product.liquid design, wired to {{ product }}.
  Gallery + buy box use the real product object + add-to-cart form.
  The editorial blocks (variety / farmer / inside) are editable section settings so
  the page works before product metafields exist (defaults reuse the placeholder copy).
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}

<div class="wrap"><div class="crumb" style="padding-top:24px"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a> / {{ product.title }}</div></div>

<!-- ===== Gallery + Buy box ===== -->
<div class="wrap"><div class="pd">
  <div class="pd-gallery" data-reveal="left">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media limit: 3 -%}
        <div class="ph img{% if forloop.first %} main{% endif %}" style="background-image:url('{{ media | image_url: width: 1000 }}')">
          {%- comment -%} role="img" sits on an empty child, not the container: role="img" makes its
          whole subtree presentational, which would hide the Sale badge below from screen readers. {%- endcomment -%}
          <span role="img" aria-label="{{ product.title | escape }}{% if product.media.size > 1 %} — photo {{ forloop.index }} of {{ product.media.size }}{% endif %}"></span>
          {%- if forloop.first and product.compare_at_price > product.price -%}<span class="tag" style="position:absolute;top:14px;left:14px">Sale</span>{%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="ph soft main" aria-hidden="true"><svg class="berry" viewBox="0 0 64 64" fill="none" stroke="rgba(110,98,86,.5)" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg></div>
      <div class="ph" aria-hidden="true"></div><div class="ph soft" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div class="pd-info" data-reveal="right">
    <h1>{{ product.title }}</h1>
    {%- if product.description != blank -%}<p class="desc">{{ product.description | strip_html | truncatewords: 38 }}</p>{%- endif -%}
    {%- if section.settings.badges != blank -%}
      <div class="pd-badges">{%- assign badges = section.settings.badges | split: ',' -%}{%- for b in badges -%}<span>{{ b | strip }}</span>{%- endfor -%}</div>
    {%- endif -%}

    <div class="pd-price">
      <b id="pd-price">{{ variant.price | money }}</b>
      {%- if variant.compare_at_price > variant.price -%}
        <s id="pd-compare">{{ variant.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
    <div class="pd-vat">VAT included{% if section.settings.shipping_note != blank %} · {{ section.settings.shipping_note }}{% endif %}</div>

    {%- if section.settings.show_facts -%}
      <div class="pd-facts">
        {%- if section.settings.fact1_label != blank -%}<div class="f"><label>{{ section.settings.fact1_label }}</label><b class="hot">{{ section.settings.fact1_value }}</b></div>{%- endif -%}
        {%- if section.settings.fact2_label != blank -%}<div class="f"><label>{{ section.settings.fact2_label }}</label><b>{{ section.settings.fact2_value }}</b></div>{%- endif -%}
        {%- if section.settings.fact3_label != blank -%}<div class="f"><label>{{ section.settings.fact3_label }}</label><b>{{ section.settings.fact3_value }}</b></div>{%- endif -%}
        <div class="f"><label>Availability</label><b class="hot">{% if product.available %}In stock{% else %}Sold out{% endif %}</b></div>
      </div>
    {%- endif -%}

    {%- form 'product', product, id: 'product-form' -%}
      {%- if product.variants.size > 1 -%}
        <div class="pd-variants">
          <label class="pd-variant-label" for="variant-select">Option</label>
          <select id="variant-select" name="id" class="pd-variant-select">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}" {% if v == variant %}selected="selected"{% endif %} {% unless v.available %}disabled="disabled"{% endunless %}>
                {{ v.title }} — {{ v.price | money }}{% unless v.available %} (Sold out){% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
      {%- endif -%}

      {%- if product.selling_plan_groups.size > 0 -%}
        <div class="pd-purchase">
          <label class="po-opt"><input type="radio" name="selling_plan" value="" checked> <span><b>One-time purchase</b> — {{ product.price | money }}</span></label>
          {%- for group in product.selling_plan_groups -%}{%- for plan in group.selling_plans -%}
            <label class="po-opt"><input type="radio" name="selling_plan" value="{{ plan.id }}"> <span><b>{{ plan.name }}</b>{%- for a in variant.selling_plan_allocations -%}{%- if a.selling_plan_id == plan.id -%} — {{ a.per_delivery_price | money }} / delivery{%- endif -%}{%- endfor -%}</span></label>
          {%- endfor -%}{%- endfor -%}
          <p class="po-note">Subscriptions renew automatically — you're billed &amp; shipped each cycle, and can cancel anytime from your account.</p>
        </div>
      {%- endif -%}

      <div class="pd-qtyrow">
        <div class="qty">
          <span style="font-size:.88rem;color:var(--greige-deep)">Quantity</span>
          <div class="ctrl">
            <button type="button" data-q="-1" aria-label="Decrease">−</button>
            <input type="number" id="quantity" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" data-q="1" aria-label="Increase">+</button>
          </div>
        </div>
      </div>

      <div class="pd-cta">
        {%- if product.available -%}
          <button type="submit" name="add" class="btn btn-red btn-block" style="padding:16px">Reserve Now</button>
        {%- else -%}
          <button type="submit" name="add" class="btn btn-ghost btn-block" style="padding:16px" disabled>Sold Out</button>
        {%- endif -%}
      </div>

      {%- render 'wishlist-button', product: product -%}
    {%- endform -%}

    {%- comment -%} App blocks (e.g. Swym Wishlist "Add to Wishlist" heart) go here, under the CTA. {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="pd-app-block" {{ block.shopify_attributes }}>{%- render block -%}</div>
      {%- endif -%}
    {%- endfor -%}

    <p class="pd-trust">🛡️ Freshness 100% guaranteed · Secure checkout · 24-hour issue window</p>
    <div class="pd-links"><a href="/pages/help#help-delivery">Delivery &amp; freshness →</a><a href="/pages/help#help-faq">Reservation FAQ →</a></div>
  </div>
</div></div>

<!-- ===== In-page tabs ===== -->
<nav class="pd-tabs" id="pdtabs">
  <a href="#overview" class="on">Overview</a>
  {%- if section.settings.show_strawberry -%}<a href="#strawberry">The Strawberry</a>{%- endif -%}
  {%- if section.settings.show_farmer -%}<a href="#farmer">The Farmer</a>{%- endif -%}
  {%- if section.settings.show_inside -%}<a href="#inside">What's Inside</a>{%- endif -%}
</nav>

<!-- ===== Overview ===== -->
<section id="overview"><div class="wrap split2">
  <div data-reveal="left">
    <span class="eyebrow">Overview</span>
    <h2 style="font-size:1.9rem;margin:10px 0 14px">{{ section.settings.overview_heading | default: 'About This Box' }}</h2>
    <div style="color:var(--greige-deep)">{{ product.description }}</div>
  </div>
  {%- if section.settings.overview_check != blank -%}
  <div class="checklist" data-reveal="right">
    {%- assign rows = section.settings.overview_check | newline_to_br | split: '<br />' -%}
    {%- for row in rows -%}
      {%- assign parts = row | strip | split: '|' -%}
      {%- if parts[0] != blank -%}<div class="ci"><span class="ck">✓</span><div><b>{{ parts[0] | strip }}</b><span>{{ parts[1] | strip }}</span></div></div>{%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}
</div></section>

<!-- ===== The Strawberry ===== -->
{%- if section.settings.show_strawberry -%}
<section id="strawberry" style="background:var(--cream-2)"><div class="wrap">
  <span class="eyebrow">The Strawberry</span>
  <h2 style="font-size:2rem;margin:10px 0 4px">{{ section.settings.berry_name }}</h2>
  {%- if section.settings.berry_sub != blank -%}<p class="lead-sub">{{ section.settings.berry_sub }}</p>{%- endif -%}
  <div class="split2" style="margin-top:30px">
    <div class="ph soft{% if section.settings.berry_image %} img{% endif %}" data-reveal="left" style="aspect-ratio:1/.82;border-radius:var(--r){% if section.settings.berry_image %};background-image:url('{{ section.settings.berry_image | image_url: width: 900 }}'){% endif %}" {% if section.settings.berry_image %}role="img" aria-label="{{ section.settings.berry_name | escape }}"{% else %}aria-hidden="true"{% endif %}></div>
    <div data-reveal="right">{{ section.settings.berry_body }}</div>
  </div>
</div></section>
{%- endif -%}

<!-- ===== The Farmer ===== -->
{%- if section.settings.show_farmer -%}
<section id="farmer"><div class="wrap">
  <span class="eyebrow">The Farmer</span>
  <div class="split2" style="margin-top:18px;align-items:start">
    <div class="ph{% if section.settings.farmer_image %} img{% endif %}" data-reveal="left" style="aspect-ratio:1/1.05;border-radius:var(--r){% if section.settings.farmer_image %};background-image:url('{{ section.settings.farmer_image | image_url: width: 900 }}'){% endif %}" {% if section.settings.farmer_image %}role="img" aria-label="{{ section.settings.farmer_name | escape }}"{% else %}aria-hidden="true"{% endif %}></div>
    <div data-reveal="right">
      <h2 style="font-size:1.9rem;margin-bottom:4px">{{ section.settings.farmer_name }}</h2>
      {%- if section.settings.farmer_meta != blank -%}<p class="lead-sub" style="font-style:normal;color:var(--red);font-weight:600;font-size:.82rem;letter-spacing:.04em">{{ section.settings.farmer_meta }}</p>{%- endif -%}
      <div style="margin-top:16px;color:var(--greige-deep)">{{ section.settings.farmer_body }}</div>
    </div>
  </div>
  {%- if section.settings.farmer_quote != blank -%}
  <div class="bigquote" data-reveal style="margin-top:34px">{{ section.settings.farmer_quote }}{% if section.settings.farmer_quote_by != blank %}<span class="by">{{ section.settings.farmer_quote_by }}</span>{% endif %}</div>
  {%- endif -%}
  <div class="pd-links" style="margin-top:18px"><a href="/pages/farmers">Read full farm story →</a></div>
</div></section>
{%- endif -%}

<!-- ===== What's Inside ===== -->
{%- if section.settings.show_inside -%}
<section id="inside" style="background:var(--cream-2)"><div class="wrap split2">
  <div class="ph soft{% if section.settings.inside_image %} img{% endif %}" data-reveal="left" style="aspect-ratio:1/.86;border-radius:var(--r){% if section.settings.inside_image %};background-image:url('{{ section.settings.inside_image | image_url: width: 900 }}'){% endif %}" {% if section.settings.inside_image %}role="img" aria-label="What's inside {{ product.title | escape }}"{% else %}aria-hidden="true"{% endif %}></div>
  <div data-reveal="right">
    <h2 style="font-size:1.9rem;margin-bottom:18px">What's Inside the Box</h2>
    {%- if section.settings.inside_check != blank -%}
    <div class="checklist">
      {%- assign rows = section.settings.inside_check | newline_to_br | split: '<br />' -%}
      {%- for row in rows -%}
        {%- assign parts = row | strip | split: '|' -%}
        {%- if parts[0] != blank -%}<div class="ci"><span class="ck">🍓</span><div><b>{{ parts[0] | strip }}</b><span>{{ parts[1] | strip }}</span></div></div>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</div></section>
{%- endif -%}

<!-- ===== Sticky reserve bar ===== -->
<div class="pd-sticky" id="pdsticky"><div class="wrap">
  <div class="ps-l">{{ product.title }} <b>{{ variant.price | money }}</b></div>
  <button class="btn btn-red" style="padding:12px 28px" {% unless product.available %}disabled{% endunless %} onclick="document.getElementById('product-form').querySelector('[name=add]').click()">{% if product.available %}Reserve Now →{% else %}Sold Out{% endif %}</button>
</div></div>

<script>
(function(){
  var qv=document.getElementById('quantity');
  document.querySelectorAll('[data-q]').forEach(function(b){b.addEventListener('click',function(){
    var n=Math.max(1,(parseInt(qv.value,10)||1)+(+b.dataset.q));qv.value=n;});});
  var sel=document.getElementById('variant-select');
  if(sel){
    var variants={{ product.variants | json }};
    var priceEl=document.getElementById('pd-price'),cmpEl=document.getElementById('pd-compare');
    sel.addEventListener('change',function(){
      var v=variants.filter(function(x){return x.id==sel.value;})[0];
      if(!v)return;
      if(priceEl)priceEl.textContent=(v.price/100).toLocaleString(undefined,{style:'currency',currency:'{{ cart.currency.iso_code | default: "PHP" }}'});
    });
  }
  var sticky=document.getElementById('pdsticky'),pd=document.querySelector('.pd');
  function onScroll(){if(!pd)return;var past=pd.getBoundingClientRect().bottom<0;sticky.classList.toggle('show',past);}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  var tabs=[].slice.call(document.querySelectorAll('#pdtabs a'));
  var secs=tabs.map(function(t){return document.querySelector(t.getAttribute('href'));});
  window.addEventListener('scroll',function(){
    var y=window.scrollY+140,act=0;
    secs.forEach(function(s,i){if(s&&s.offsetTop<=y)act=i;});
    tabs.forEach(function(t,i){t.classList.toggle('on',i===act);});
  },{passive:true});
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Buy box" },
    { "type": "text", "id": "badges", "label": "Badges (comma-separated)", "default": "🍓 Premium Variety, 🌾 Single Farm, ❄ Cold Chain" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Cold-chain delivery to your door" },
    { "type": "checkbox", "id": "show_facts", "label": "Show fact grid", "default": true },
    { "type": "text", "id": "fact1_label", "label": "Fact 1 label", "default": "Next Arrival" },
    { "type": "text", "id": "fact1_value", "label": "Fact 1 value", "default": "March 15, 2025" },
    { "type": "text", "id": "fact2_label", "label": "Fact 2 label", "default": "Reservation Deadline" },
    { "type": "text", "id": "fact2_value", "label": "Fact 2 value", "default": "March 12, 2025" },
    { "type": "text", "id": "fact3_label", "label": "Fact 3 label", "default": "Delivery Window" },
    { "type": "text", "id": "fact3_value", "label": "Fact 3 value", "default": "March 16–17" },

    { "type": "header", "content": "Overview" },
    { "type": "text", "id": "overview_heading", "label": "Overview heading", "default": "About This Box" },
    { "type": "textarea", "id": "overview_check", "label": "Checklist (one per line, Title | Detail)", "default": "Hand-picked berries | Picked at peak ripeness, graded by size and color before packing.\nPremium seasonal variety | Sweeter than supermarket fruit by a wide margin.\nCold chain door to door | Temperature-controlled from greenhouse to your fridge, photo-documented." },

    { "type": "header", "content": "The Strawberry" },
    { "type": "checkbox", "id": "show_strawberry", "label": "Show section", "default": true },
    { "type": "text", "id": "berry_name", "label": "Variety name", "default": "Premium Seasonal Variety" },
    { "type": "text", "id": "berry_sub", "label": "Subtitle", "default": "red · round · big · delicious" },
    { "type": "image_picker", "id": "berry_image", "label": "Image" },
    { "type": "richtext", "id": "berry_body", "label": "Body", "default": "<p>We work with premium seasonal Japanese strawberry varieties, grown with patience and care for flavour and sweetness.</p><p>Each berry has a deep red exterior and is far sweeter than most imported strawberries.</p>" },

    { "type": "header", "content": "The Farmer" },
    { "type": "checkbox", "id": "show_farmer", "label": "Show section", "default": true },
    { "type": "text", "id": "farmer_name", "label": "Farm name", "default": "Farm A" },
    { "type": "text", "id": "farmer_meta", "label": "Meta line", "default": "CHIBA, JAPAN · FAMILY-RUN GREENHOUSE" },
    { "type": "image_picker", "id": "farmer_image", "label": "Image" },
    { "type": "richtext", "id": "farmer_body", "label": "Body", "default": "<p><b>A family-run greenhouse focused on doing one craft well.</b></p><p>The family behind Farm A grows on a small scale — small enough that every plant is hand-inspected.</p>" },
    { "type": "text", "id": "farmer_quote", "label": "Quote", "default": "\"We don't try to be the biggest farm. We try to be the one our customers actually remember.\"" },
    { "type": "text", "id": "farmer_quote_by", "label": "Quote attribution", "default": "— our grower, Farm A" },

    { "type": "header", "content": "What's Inside" },
    { "type": "checkbox", "id": "show_inside", "label": "Show section", "default": true },
    { "type": "image_picker", "id": "inside_image", "label": "Image" },
    { "type": "textarea", "id": "inside_check", "label": "Checklist (one per line, Title | Detail)", "default": "Premium strawberries | Picked at peak ripeness at Farm A.\nInsulated outer box | EPS foam, reflective foil lining.\nGel ice packs | Kept cold from dispatch through transit.\nIndividual cup tray | No stacking, no bruising.\nQC photo card + farm note | Harvest details for your box." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
