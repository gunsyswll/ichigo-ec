{%- comment -%} Shop / Reserve page — converted verbatim from src/shop.body.html {%- endcomment -%}
<section class="page-hero"><div class="wrap">
  <div class="crumb"><a href="{{ routes.root_url }}">Home</a> / Shop / Reserve</div>
  <h1>Shop &amp; <span class="r">Reserve</span></h1>
  <p>Browse all available strawberry boxes. Filter by arrival, gift, or subscription.</p>
  <div class="stats">
    <div class="stat"><label>Next Arrival</label><b>Mar 15, 2025</b></div>
    <div class="stat"><label>Reservation Deadline</label><b>Mar 12, 2025</b></div>
    <div class="stat"><label>Available Boxes</label><b>Limited</b></div>
  </div>
  <div class="shop-nudge"><a href="{{ routes.root_url }}#journey">How it works · 36–48h fresh →</a><span>·</span><a href="/pages/help">Questions? Visit Help →</a></div>
</div></section>

<section id="club" style="padding:40px 0 84px;scroll-margin-top:90px"><div class="wrap">
  <div class="filters" data-reveal>
    <a class="active" href="#" data-filter="all">All Products</a><a href="#" data-filter="arrival">This Week's Arrival</a><a href="#" data-filter="preorder">Next Arrival / Pre-order</a><a href="#" data-filter="gift">Gift Box</a><a href="#" data-filter="subscription">Subscription</a><a href="#" data-filter="soldout">Sold Out / Waitlist</a>
  </div>
  <div class="shop-bar"><span>Showing <b style="color:var(--ink)">9</b> of 12 products</span><label>Sort by <select><option>Featured</option><option>Price: Low to High</option><option>Newest</option></select></label></div>
  <div class="shop-grid" data-stagger>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph soft"><span class="card-tag tag-pre">Pre-order</span></div><div data-cat="preorder arrival" class="card-body"><h3>Standard Strawberry Box</h3><p class="desc">The everyday little luxury.</p><div class="price">From ₱2,800</div><div class="meta">Next Arrival: March 15</div><span class="btn btn-red">Reserve Now</span></div></a>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph"><span class="card-tag tag-gift">Gift</span></div><div data-cat="gift" class="card-body"><h3>Premium Gift Box</h3><p class="desc">Grand-grade, beautifully wrapped.</p><div class="price">From ₱4,800</div><div class="meta">Next Arrival: March 15</div><span class="btn btn-red">Reserve Now</span></div></a>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph soft"><span class="card-tag tag-sub">Subscription</span></div><div data-cat="subscription" class="card-body"><h3>Japanese Strawberry Club</h3><p class="desc">A different lot each month.</p><div class="price">From ₱7,200 <span class="sm">/ 3 deliveries</span></div><div class="meta">Recurring</div><span class="btn btn-outline-red">View Subscription</span></div></a>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph"><span class="card-tag tag-new">New</span></div><div data-cat="new arrival" class="card-body"><h3>Amaou Premium Box</h3><p class="desc">A prized Japanese variety.</p><div class="price">From ₱5,200</div><div class="meta">Next Arrival: March 15</div><span class="btn btn-red">Reserve Now</span></div></a>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph soft"><span class="card-tag tag-pre">Pre-order</span></div><div data-cat="preorder arrival" class="card-body"><h3>Tochiotome Box</h3><p class="desc">Bright, aromatic, balanced.</p><div class="price">From ₱3,400</div><div class="meta">Next Arrival: March 15</div><span class="btn btn-red">Reserve Now</span></div></a>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph"><span class="card-tag tag-gift">Gift</span></div><div data-cat="gift" class="card-body"><h3>Luxury Wooden Gift Box</h3><p class="desc">Our finest presentation.</p><div class="price">From ₱6,500</div><div class="meta">Next Arrival: March 15</div><span class="btn btn-red">Reserve Now</span></div></a>
    <div class="card sold" data-reveal><div class="ph grey"><span class="soldflag"><span>SOLD OUT</span></span></div><div data-cat="soldout" class="card-body"><h3>Sky Berry Limited Box</h3><p class="desc">Rare white strawberries.</p><div class="price" style="color:var(--greige-deep)">From ₱4,200</div><div class="meta">Currently unavailable</div><span class="btn btn-ghost">Join Waitlist</span></div></div>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph soft"><span class="card-tag tag-pre">Pre-order</span></div><div data-cat="preorder arrival" class="card-body"><h3>Mixed Variety Box</h3><p class="desc">A taste of every farm.</p><div class="price">From ₱3,800</div><div class="meta">Next Arrival: March 15</div><span class="btn btn-red">Reserve Now</span></div></a>
    <a class="card" href="{{ routes.all_products_collection_url }}" data-reveal><div class="ph"><span class="card-tag tag-sub">Subscription</span></div><div data-cat="subscription" class="card-body"><h3>Premium Hanpukai Plan</h3><p class="desc">The premium 3-month club.</p><div class="price">From ₱12,000 <span class="sm">/ 3 deliveries</span></div><div class="meta">Recurring</div><span class="btn btn-outline-red">View Subscription</span></div></a>
  </div>
  <div class="pager"><a href="#">‹</a><a class="active" href="#">1</a><a href="#">2</a><a href="#">›</a></div>
  <div class="news-strip" data-reveal style="margin-top:56px">
    <div><h3>Can't decide? Get notified before the next arrival.</h3><p style="color:var(--greige-deep);font-size:.9rem;margin-top:4px">Be first when a new lot lands from Japan.</p></div>
    <form class="row" onsubmit="return false"><input type="email" placeholder="Email Address" style="padding:13px 18px;border-radius:100px;border:1.5px solid var(--line);background:var(--cream);min-width:230px"><button class="btn btn-red">Join the List</button></form>
  </div>
</div></section>

{% schema %}
{
  "name": "Shop page",
  "settings": [
    { "type": "paragraph", "content": "Product cards here are static design placeholders. Wire them to a real collection / products in Shopify; the cart/reserve buttons link to the catalog route." }
  ],
  "presets": [{ "name": "Shop page" }]
}
{% endschema %}
