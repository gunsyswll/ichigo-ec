{%- comment -%} Shop / Reserve page — real product grid wired to the store catalog. {%- endcomment -%}
<section class="page-hero"><div class="wrap">
  <h1>Shop &amp; <span class="r">Reserve</span></h1>
  <p>Browse all available strawberry boxes. Reserve your box before the next arrival.</p>
  <div class="stats">
    <div class="stat"><label>Next Arrival</label><b>Mar 15, 2025</b></div>
    <div class="stat"><label>Reservation Deadline</label><b>Mar 12, 2025</b></div>
    <div class="stat"><label>Available Boxes</label><b>Limited</b></div>
  </div>
  <div class="shop-nudge"><a href="{{ routes.root_url }}#journey">How it works · 36–48h fresh →</a><span>·</span><a href="/pages/help">Questions? Visit Help →</a></div>
</div></section>

<section id="club" style="padding:40px 0 84px;scroll-margin-top:90px"><div class="wrap">
  {%- paginate collections.all.products by 12 -%}
  <div class="shop-bar">
    <span>Showing <b style="color:var(--ink)">{{ paginate.items }}</b> {{ paginate.items | pluralize: 'product', 'products' }}</span>
  </div>
  {%- if paginate.items > 0 -%}
    <div class="shop-grid" data-stagger>
      {%- for product in collections.all.products -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pager">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}<a class="active" href="#">{{ part.title }}</a>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="cart-empty" data-reveal>
      <h2>No products yet</h2>
      <p>New strawberry boxes are landing soon. Check back before the next arrival.</p>
      <a class="btn btn-red" href="{{ routes.root_url }}">Back to home</a>
    </div>
  {%- endif -%}
  {%- endpaginate -%}
  <div class="news-strip" data-reveal style="margin-top:56px">
    <div><h3>Can't decide? Get notified before the next arrival.</h3><p style="color:var(--greige-deep);font-size:.9rem;margin-top:4px">Be first when a new lot lands from Japan.</p></div>
    <form class="row" onsubmit="return false"><input type="email" placeholder="Email Address" style="padding:13px 18px;border-radius:100px;border:1.5px solid var(--line);background:var(--cream);min-width:230px"><button class="btn btn-red">Join the List</button></form>
  </div>
</div></section>

{% schema %}
{
  "name": "Shop page",
  "settings": [
    { "type": "paragraph", "content": "Shows the real store catalog (collections.all) via the product-card snippet. No static tiles." }
  ],
  "presets": [{ "name": "Shop page" }]
}
{% endschema %}
