{%- comment -%} About page — converted verbatim from src/about.body.html {%- endcomment -%}
<section class="page-hero"><div class="wrap">
  <h1>Bringing Japan's Finest<br><span class="r">Strawberries to the Philippines</span></h1>
  <p>The trusted partner for premium Japanese strawberries — sourced direct, imported officially, delivered fresh.</p>
</div></section>

<!-- pinned jump-nav -->
<div class="jump-tabs" id="about-tabs" role="navigation" aria-label="About sections">
  <a class="seg-tab active" href="#story" data-spy="story">Our Story</a>
  <a class="seg-tab" href="#importer" data-spy="importer">Official Importer</a>
  <a class="seg-tab" href="#team" data-spy="team">Our Farms &amp; Team</a>
  <a class="seg-tab" href="#journey" data-spy="journey">Japan → Philippines</a>
</div>

<section id="story" class="jump-target"><div class="wrap">
  <div class="titleline" data-reveal><h2>Our Story &amp; Mission</h2></div>
  <div class="story-grid">
    <div class="ph soft" data-reveal="left"></div>
    <div data-reveal="right">
      <h3 style="font-size:1.2rem;margin-bottom:10px">Why We Started</h3>
      <p style="color:var(--greige-deep)">We saw a gap: the Philippines loves Japanese fruit, but truly fresh, single-origin strawberries were almost impossible to get — and when you could, the story behind them was lost. We started Ichigo to close that gap, farm to door.</p>
      <h3 style="font-size:1.2rem;margin:22px 0 10px">Our Values</h3>
      <ul class="values">
        <li><div><b>Quality without compromise</b><span>Only peak-ripeness, single-origin fruit.</span></div></li>
        <li><div><b>Direct from the source</b><span>Two farms we know by name, not a marketplace.</span></div></li>
        <li><div><b>Transparent partnerships</b><span>Officially imported, honestly told.</span></div></li>
      </ul>
    </div>
  </div>
  <div class="statband" data-reveal>
    <div class="s"><b data-count="2023">0</b><label>Founded</label></div><div class="s"><b data-count="2">0</b><label>Partner Farms</label></div><div class="s"><b data-count="1200" data-suf="+">0</b><label>Boxes Delivered</label></div><div class="s"><b data-count="800" data-suf="+">0</b><label>Happy Customers</label></div>
  </div>
</div></section>

<section id="importer" class="jump-target" style="background:var(--cream-2)"><div class="wrap">
  <div class="titleline" data-reveal><h2>Officially Imported &amp; Managed in the Philippines</h2></div>
  <p data-reveal style="color:var(--greige-deep);max-width:52em;margin-bottom:30px">A single official import partner handles sourcing, customs, cold‑chain, and delivery — so what reaches you is traceable, compliant, and accountable, not grey‑market.</p>
  <div class="cred-grid cred-2" data-stagger>
    <div class="cred" data-reveal><div class="ic"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 2v14M5 6l4-4 4 4M3 11h12"/></svg></div><b>Cold Chain</b><p>Temperature-controlled end to end.</p></div>
    <div class="cred" data-reveal><div class="ic"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="14" height="10" rx="1.5"/><path d="M2 8h14"/></svg></div><b>Customs Cleared</b><p>Every lot, fully documented.</p></div>
      </div>
  <div style="display:flex;gap:14px;margin-top:24px;flex-wrap:wrap" data-reveal>
    <div class="ph grey" style="height:60px;width:130px;border-radius:8px"></div><div class="ph grey" style="height:60px;width:130px;border-radius:8px"></div><div class="ph grey" style="height:60px;width:130px;border-radius:8px"></div><div class="ph grey" style="height:60px;width:130px;border-radius:8px"></div>
  </div>
</div></section>

<!-- moved here: directly under the Officially Imported block; founders -> the two farms, linked to the Farmers page -->
<section id="team" class="jump-target" style="background:var(--pink)"><div class="wrap">
  <div class="sec-head" data-reveal><span class="eyebrow muted">Our growers &amp; team</span><h2>The people behind the brand</h2></div>
  <div class="method-grid" data-stagger>
    <a class="method linkcard" href="/pages/farmers#farm-a" data-reveal><div class="ph soft" data-img="people" style="aspect-ratio:1/1;border-radius:50%;width:90px;margin:0 auto 14px"></div><h3>Farm A</h3><p>A family-run greenhouse · Chiba, Japan</p><span class="link">View farm story →</span></a>
    <a class="method linkcard" href="/pages/farmers#farm-b" data-reveal><div class="ph" data-img="people" style="aspect-ratio:1/1;border-radius:50%;width:90px;margin:0 auto 14px"></div><h3>Farm B</h3><p>A family-run greenhouse · Chiba, Japan</p><span class="link">View farm story →</span></a>
    <div class="method" data-reveal><div class="ph grey" style="aspect-ratio:1/1;border-radius:50%;width:90px;margin:0 auto 14px"></div><h3>Japan Partner</h3><p>JP Sourcing Lead</p></div>
  </div>
</div></section>

<section id="journey" class="jump-target"><div class="wrap">
  <div class="titleline" data-reveal><h2>From Japan to the Philippines</h2></div>
  <div class="timeline light" data-stagger>
    <div class="tl-step" data-reveal><div class="tl-card"><h3>Harvest in Japan</h3><p>Picked at peak ripeness</p></div><div class="tl-dot"><span class="tl-no">1</span></div></div>
    <div class="tl-step" data-reveal><div class="tl-card"><h3>Quality Check (JP)</h3><p>Sorted &amp; graded</p></div><div class="tl-dot"><span class="tl-no">2</span></div></div>
    <div class="tl-step" data-reveal><div class="tl-card"><h3>Cold Chain Air</h3><p>Temperature-controlled</p></div><div class="tl-dot"><span class="tl-no">3</span></div></div>
    <div class="tl-step" data-reveal><div class="tl-card"><h3>PH Customs</h3><p>Cleared &amp; documented</p></div><div class="tl-dot"><span class="tl-no">4</span></div></div>
    <div class="tl-step" data-reveal><div class="tl-card"><h3>Local QC</h3><p>Re-inspected on arrival</p></div><div class="tl-dot"><span class="tl-no">5</span></div></div>
    <div class="tl-step" data-reveal><div class="tl-card"><h3>Delivered to You</h3><p>Fresh, to your door</p></div><div class="tl-dot"><span class="tl-no">6</span></div></div>
  </div>
  <div class="ph soft" data-reveal style="aspect-ratio:16/6;border-radius:var(--r);margin-top:20px"></div>
  <p data-reveal style="text-align:center;margin-top:18px;color:var(--greige-deep)">Cold-chain fresh, <b style="color:var(--red)">door to door</b> from Japanese farm to PH customer.</p>
</div></section>

<section style="padding-top:0;margin-top:84px"><div class="wrap"><div class="cta-band" data-reveal="scale">
  <div><h2>Experience the freshness for yourself</h2></div>
  <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-white" href="/collections/all">Shop Now</a><a class="btn btn-ghost" href="/pages/farmers" style="color:#fff;border-color:rgba(255,255,255,.5)">Meet the Farmers</a></div>
</div></div></section>

