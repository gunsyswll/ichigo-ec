<section class="news">
  <div class="wrap news-grid">
    <div data-reveal="left">
      <span class="eyebrow muted">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:12px">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="news-form">
          <div class="news-row"><input type="text" name="contact[first_name]" placeholder="Your Name"><input type="email" name="contact[email]" placeholder="Email Address" required></div>
          <div class="checks"><span style="font-weight:500;color:var(--ink)">I'm interested in:</span><label><input type="checkbox"> Next Arrival</label><label><input type="checkbox"> Gift Box</label><label><input type="checkbox"> Subscription</label></div>
          {%- if form.posted_successfully? -%}<p style="color:#2f7e48;font-weight:600;margin-top:4px">✓ Thanks — you're on the list.</p>{%- endif -%}
          <button class="btn btn-red" type="submit" style="align-self:flex-start;margin-top:4px">{{ section.settings.button_label }}</button>
        </div>
      {%- endform -%}
    </div>
    <div class="news-photo" data-reveal="right"><div class="ph soft" data-parallax="0.12"><svg class="berry" viewBox="0 0 64 64" fill="none" stroke="rgba(110,98,86,.55)" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg></div></div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Never miss an arrival" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get notified before the next arrival" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Lots are small and sell out. Join the list for arrival alerts, pre-order reminders, and how-to-enjoy notes." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the List" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
