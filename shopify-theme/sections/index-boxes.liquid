<section class="boxes" id="shop">
  <div class="wrap">
    <div class="sec-head" data-reveal><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2>{% if section.settings.subtext != blank %}<p>{{ section.settings.subtext }}</p>{% endif %}</div>
    <div class="box-grid" data-stagger>
      {%- paginate collections.all.products by 4 -%}
        {%- for product in collections.all.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- endpaginate -%}
    </div>
    <div style="text-align:center;margin-top:40px" data-reveal><a class="btn btn-red" href="/collections/all">View all boxes</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Choose your box",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop or Reserve" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your strawberries" },
    { "type": "textarea", "id": "subtext", "label": "Subtext（空でよい）" }
  ],
  "presets": [
    { "name": "Choose your box" }
  ]
}
{% endschema %}
