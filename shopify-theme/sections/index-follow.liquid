{%- liquid
  comment
  URL は「テーマ設定 → SNS」が既定。セクション個別に入れたときだけそちらが優先される。
  endcomment
  assign ig = section.settings.instagram_url | default: settings.social_instagram_url
  assign fb = section.settings.facebook_url  | default: settings.social_facebook_url
-%}
<section id="follow-{{ section.id }}" class="news">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow muted">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
    <div class="follow-cta" data-reveal style="justify-content:center">
      {%- if ig != blank -%}
      <a class="btn btn-outline-red" href="{{ ig }}" target="_blank" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg> Instagram</a>
      {%- endif -%}
      {%- if fb != blank -%}
      <a class="btn btn-outline-red" href="{{ fb }}" target="_blank" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H17V3.6c-.29-.04-1.3-.13-2.47-.13-2.44 0-4.11 1.49-4.11 4.22v2.36H7.7V13h2.72v8z"/></svg> Facebook</a>
      {%- endif -%}
    </div>
    <div class="follow-grid" data-reveal>
      {%- for i in (1..4) -%}
      <div class="ig-tile"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/></svg></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
    <p class="follow-note" style="text-align:center">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Follow us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@ichigo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Daily berries, arrivals, and behind-the-farm moments." },
    { "type": "paragraph", "content": "空欄なら「テーマ設定 → SNS」の URL を使います。" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "text", "id": "note", "label": "Note under grid", "default": "Instagram feed coming soon." }
  ],
  "presets": [{ "name": "Follow us" }]
}
{% endschema %}
