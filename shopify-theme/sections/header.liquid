<header><div class="wrap nav">
  <a class="brand" href="{{ routes.root_url }}"><span class="seed"></span> <b>{{ section.settings.brand | default: 'Ichigo' }}</b><span style="color:var(--greige);font-size:.92rem;font-family:Outfit;letter-spacing:.1em">／苺</span></a>
  <nav class="links">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Shop / Reserve</a><a href="/collections/all#club">Subscription</a><a href="/pages/farmers">Farmers</a><a href="{{ routes.root_url }}#journey">How It Works</a><a href="/pages/about">About</a><a href="/pages/help">Help</a>
    {%- endfor -%}
  </nav>
  <div class="nav-right">
    <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></a>
    <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6h15l-1.5 9h-12L6 6zM6 6l-1-3H2"/><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg><span class="dot">{{ cart.item_count }}</span></a>
    <a class="btn btn-red hide-mobile" href="{{ routes.all_products_collection_url }}" style="padding:11px 20px">{{ section.settings.cta_label | default: 'Reserve Now' }}</a>
    <div class="burger"><span></span><span></span><span></span></div>
  </div>
</div></header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "Ichigo" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu" },
    { "type": "text", "id": "cta_label", "label": "Header button label", "default": "Reserve Now" }
  ]
}
{% endschema %}
