<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="rise r2">{{ section.settings.heading_1 }}</h1>
      <h1 class="rise r2" style="color:var(--red)">{{ section.settings.heading_2 }}</h1>
      <p class="lead rise r3">{{ section.settings.lead }}</p>
      <div class="hero-cta rise r4"><a class="btn btn-red" href="{{ section.settings.cta1_url | default: '/collections/all' }}">{{ section.settings.cta1_label }}</a><a class="btn btn-ghost" href="{{ section.settings.cta2_url | default: '/collections/all' }}">{{ section.settings.cta2_label }}</a></div>
      <div class="badges rise r5">
        <div class="badge"><span class="bi"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 1l2 4 4 .5-3 3 .8 4L8 14.5 4.2 16.5 5 12.5 2 9.5 6 9z" transform="scale(.9) translate(1,0)"/></svg></span><div><b>{{ section.settings.badge1_t }}</b><span>{{ section.settings.badge1_s }}</span></div></div>
        <div class="badge"><span class="bi"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 1.5"/></svg></span><div><b>{{ section.settings.badge2_t }}</b><span>{{ section.settings.badge2_s }}</span></div></div>
        <div class="badge"><span class="bi"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8.5l3 3 7-7.5"/></svg></span><div><b>{{ section.settings.badge3_t }}</b><span>{{ section.settings.badge3_s }}</span></div></div>
      </div>
    </div>
    <div class="hero-photo rise r3"><div class="ph" data-parallax><svg class="berry" viewBox="0 0 64 64" fill="none" stroke="rgba(255,255,255,.85)" stroke-width="2.2"><path d="M32 20c8-10 22-8 22-8s2 14-8 22-22 18-22 18S14 42 14 32s10-12 18-12z"/><path d="M28 12c2 4 4 6 4 8M36 12c-2 4-4 6-4 8M32 8v6"/></svg></div></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Premium Japanese<br>strawberries," },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (red)", "default": "<em>delivered fresh</em><br>in the Philippines." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Picked at peak ripeness on two family farms in Japan, cold-chain flown to you, and reserved by the lot — so every box arrives at its sweetest. Not a formal gift; a little luxury for yourself." },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA label", "default": "Reserve Next Arrival →" },
    { "type": "url", "id": "cta1_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Join the Waitlist" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA URL" },
    { "type": "text", "id": "badge1_t", "label": "Badge 1 title", "default": "Official" },
    { "type": "text", "id": "badge1_s", "label": "Badge 1 subtitle", "default": "Import Partner" },
    { "type": "text", "id": "badge2_t", "label": "Badge 2 title", "default": "Limited" },
    { "type": "text", "id": "badge2_s", "label": "Badge 2 subtitle", "default": "Seasonal Arrival" },
    { "type": "text", "id": "badge3_t", "label": "Badge 3 title", "default": "Freshness" },
    { "type": "text", "id": "badge3_s", "label": "Badge 3 subtitle", "default": "Checked" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
