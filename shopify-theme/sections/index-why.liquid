<section id="why">
  <div class="wrap">
    <div class="sec-head" data-reveal><span class="eyebrow muted">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
    <div class="why-grid" data-stagger>
      {%- for block in section.blocks -%}
      <div class="why" data-reveal {{ block.shopify_attributes }}><div class="ic">
        {%- case block.settings.icon -%}
        {%- when 'plant' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M11 3v17M5 9s2-4 6-4 6 4 6 4M5 9s0 8 6 8 6-8 6-8" transform="scale(.9) translate(1,1)"/></svg>
        {%- when 'star' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M11 2l2.5 5 5.5.8-4 4 1 5.5L11 14.5 6 17l1-5.5-4-4 5.5-.8z"/></svg>
        {%- when 'box' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="8" width="16" height="11" rx="1.5"/><path d="M3 12h16M11 8V5M7 5h8"/></svg>
        {%- when 'clock' -%}<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="8"/><path d="M11 7v4l3 2"/></svg>
        {%- endcase -%}
      </div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why different",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Japanese strawberries are different" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The quality you can taste" }
  ],
  "blocks": [
    { "type": "item", "name": "Reason", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "plant", "options": [ {"value":"plant","label":"Plant"},{"value":"star","label":"Star"},{"value":"box","label":"Box"},{"value":"clock","label":"Clock"} ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Carefully Grown" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Raised on two family farms with decades of strawberry craft." }
    ] }
  ],
  "presets": [
    { "name": "Why different", "blocks": [
      { "type": "item", "settings": { "icon": "plant", "title": "Carefully Grown", "text": "Raised on two family farms with decades of strawberry craft." } },
      { "type": "item", "settings": { "icon": "star", "title": "Beautifully Sweet", "text": "Picked at full Brix the morning before shipping — never early." } },
      { "type": "item", "settings": { "icon": "box", "title": "Gift-Worthy Quality", "text": "Grand-grade fruit, beautifully boxed — a treat worth giving." } },
      { "type": "item", "settings": { "icon": "clock", "title": "Limited by Season", "text": "Available only by the lot, only while the harvest is at its best." } }
    ] }
  ]
}
{% endschema %}
