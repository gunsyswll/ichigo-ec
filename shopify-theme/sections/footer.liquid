{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "Ichigo" },
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Premium Japanese strawberries, reserved by the lot and delivered fresh across the Philippines." }
  ]
}
{% endschema %}
