<footer><div class="wrap">
  <div class="foot-grid">
    <div class="foot-brand"><a class="brand" href="{{ routes.root_url }}"><span class="seed"></span> <b>{{ section.settings.brand | default: 'Ichigo' }}</b></a><p>{{ section.settings.blurb }}</p></div>
    <div class="foot-col"><h4>Shop</h4><a href="/collections/all">All Products</a><a href="/collections/all">Gift Boxes</a><a href="/collections/all#club">Subscription (Club)</a><a href="/collections/all">Sold Out / Waitlist</a></div>
    <div class="foot-col"><h4>Information</h4><a href="/pages/about">About Us</a><a href="/pages/farmers">Farmers</a><a href="{{ routes.root_url }}#journey">How It Works</a><a href="/pages/help#help-delivery">Delivery &amp; Freshness</a><a href="/pages/help#help-faq">FAQ</a></div>
    <div class="foot-col"><h4>Policies</h4><a href="{{ shop.privacy_policy.url | default: '#' }}">Privacy Policy</a><a href="{{ shop.terms_of_service.url | default: '#' }}">Terms of Service</a><a href="{{ shop.refund_policy.url | default: '/pages/help#help-faq' }}">Refund &amp; Returns</a><a href="{{ shop.shipping_policy.url | default: '/pages/help#help-delivery' }}">Shipping Policy</a><a href="/collections/all#club">Subscription Policy</a></div>
    <div class="foot-col"><h4>Account</h4><a href="/pages/help#help-faq">Contact / Support</a><a href="{{ routes.account_url }}">My Account</a><a href="{{ routes.account_url }}">Order History</a><a href="{{ routes.account_addresses_url }}">Addresses</a></div>
  </div>
  <div class="foot-bottom">
    <div class="legal"><a href="{{ shop.privacy_policy.url | default: '#' }}">Privacy</a><span>·</span><a href="{{ shop.terms_of_service.url | default: '#' }}">Terms</a><span>·</span><a href="{{ shop.refund_policy.url | default: '/pages/help#help-faq' }}">Refund</a><span>·</span><a href="{{ shop.shipping_policy.url | default: '/pages/help#help-delivery' }}">Shipping</a><span>·</span><a href="/collections/all#club">Subscription</a><span>·</span><a href="#">Cookie</a><span>·</span><a href="#">Legal Notice</a></div>
    <div class="pays"><span>GCash</span><span>Maya</span><span>VISA</span><span>Mastercard</span><span style="border:none;background:none">PH | EN</span></div>
  </div>
</div></footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "Ichigo" },
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Premium Japanese strawberries, reserved by the lot and delivered fresh across the Philippines." }
  ]
}
{% endschema %}
