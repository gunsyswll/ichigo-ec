<footer><div class="wrap">
  <div class="foot-grid">
    <div class="foot-brand"><a class="brand" href="{{ routes.root_url }}"><span class="seed"></span> <b>{{ section.settings.brand | default: 'Ichigo' }}</b></a><p>{{ section.settings.blurb }}</p></div>
    <div class="foot-col"><h4>Shop</h4><a href="/collections/all">All Products</a><a href="/collections/all">Gift Boxes</a><a href="/products/japanese-strawberry-club">Subscription (Club)</a><a href="/pages/waitlist">Sold Out / Waitlist</a></div>
    <div class="foot-col"><h4>Information</h4><a href="/pages/about">About Us</a><a href="/pages/farmers">Farmers</a><a href="{{ routes.root_url }}#journey">How It Works</a><a href="/pages/help#help-delivery">Delivery &amp; Freshness</a><a href="/pages/help#help-faq">FAQ</a></div>
    <div class="foot-col"><h4>Policies</h4>{%- if shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{%- endif -%}{%- if shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms of Service</a>{%- endif -%}<a href="{{ shop.refund_policy.url | default: '/pages/help#help-faq' }}">Refund &amp; Returns</a><a href="{{ shop.shipping_policy.url | default: '/pages/help#help-delivery' }}">Shipping Policy</a><a href="/collections/all#club">Subscription Policy</a></div>
    <div class="foot-col"><h4>Account</h4><a href="/pages/help#help-faq">Contact / Support</a><a href="{{ routes.account_url }}">My Account</a><a href="{{ routes.account_url }}">Order History</a><a href="{{ routes.account_addresses_url }}">Addresses</a></div>
  </div>
  <div class="foot-bottom">
    <div class="legal">{%- if shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a><span>·</span>{%- endif -%}{%- if shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms</a><span>·</span>{%- endif -%}<a href="{{ shop.refund_policy.url | default: '/pages/help#help-faq' }}">Refund</a><span>·</span><a href="{{ shop.shipping_policy.url | default: '/pages/help#help-delivery' }}">Shipping</a><span>·</span><a href="/pages/shop#club">Subscription</a>{%- if section.settings.cookie_policy_url != blank -%}<span>·</span><a href="{{ section.settings.cookie_policy_url }}">Cookie</a>{%- endif -%}{%- if section.settings.legal_notice_url != blank -%}<span>·</span><a href="{{ section.settings.legal_notice_url }}">Legal Notice</a>{%- endif -%}</div>
    {% render 'social-icons', variant: 'footer', class: 'foot-social', instagram: section.settings.instagram_url, facebook: section.settings.facebook_url %}
    <div class="pays"><span>GCash</span><span>Maya</span><span>VISA</span><span>Mastercard</span><span style="border:none;background:none">PH | EN</span></div>
  </div>
</div></footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "Ichigo" },
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Premium Japanese strawberries, reserved by the lot and delivered fresh to the Philippines." },

    { "type": "header", "content": "Legal links" },
    { "type": "url", "id": "cookie_policy_url", "label": "Cookie Policy URL" },
    { "type": "url", "id": "legal_notice_url", "label": "Legal Notice URL" },

    { "type": "header", "content": "Social" },
    { "type": "paragraph", "content": "空欄なら「テーマ設定 → SNS」の URL を使います。このフッターだけ別のリンクにしたいときだけ入力してください。" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" }
  ]
}
{% endschema %}
