<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
{%- comment -%} Shared page title, reused for <title>, og:title and twitter:title so they never drift apart. {%- endcomment -%}
{%- capture seo_title -%}{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}{%- endcapture -%}
<title>{{ seo_title }}</title>

{%- comment -%}
  SEO description: page_description (Shopify's own SEO field) → product description →
  article excerpt → theme default (Settings → SEO & Social → Default meta description).
  This layout only serves the launch landing page today, but mirrors theme.liquid's
  fallback chain in case it's ever reused for a product/article.
{%- endcomment -%}
{%- assign seo_description = page_description -%}
{%- if seo_description == blank and product != blank -%}
  {%- assign seo_description = product.description | strip_html | strip_newlines | truncate: 160 -%}
{%- endif -%}
{%- if seo_description == blank and article != blank -%}
  {%- assign seo_description = article.excerpt | strip_html | strip_newlines | truncate: 160 -%}
{%- endif -%}
{%- if seo_description == blank -%}
  {%- assign seo_description = settings.meta_description -%}
{%- endif -%}
{%- if seo_description != blank -%}<meta name="description" content="{{ seo_description | escape }}">{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">

{%- comment -%}
  Open Graph + Twitter card. Image: product/article featured image first, else the
  Settings → SEO & Social → Default social share image. image_url can return a
  protocol-relative URL, so force https: for the sharing tags.
{%- endcomment -%}
{%- assign seo_image = blank -%}
{%- if product != blank and product.featured_image -%}
  {%- assign seo_image = product.featured_image | image_url: width: 1200 -%}
{%- elsif article != blank and article.image -%}
  {%- assign seo_image = article.image | image_url: width: 1200 -%}
{%- elsif settings.social_share_image != blank -%}
  {%- assign seo_image = settings.social_share_image | image_url: width: 1200 -%}
{%- endif -%}
{%- if seo_image != blank -%}
  {%- unless seo_image contains 'http' -%}
    {%- assign seo_image = seo_image | prepend: 'https:' -%}
  {%- endunless -%}
{%- endif -%}
{%- assign seo_type = 'website' -%}
{%- if template.name == 'product' -%}
  {%- assign seo_type = 'product' -%}
{%- elsif template.name == 'article' -%}
  {%- assign seo_type = 'article' -%}
{%- endif -%}
<meta property="og:title" content="{{ seo_title | escape }}">
{%- if seo_description != blank -%}<meta property="og:description" content="{{ seo_description | escape }}">{%- endif -%}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{{ seo_type }}">
<meta property="og:site_name" content="{{ shop.name }}">
{%- if seo_image != blank -%}<meta property="og:image" content="{{ seo_image }}">{%- endif -%}
<meta name="twitter:card" content="{% if seo_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{%- if seo_description != blank -%}<meta name="twitter:description" content="{{ seo_description | escape }}">{%- endif -%}
{%- if seo_image != blank -%}<meta name="twitter:image" content="{{ seo_image }}">{%- endif -%}

{%- if settings.favicon != blank -%}
<link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
{%- endif -%}

<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
{{ 'theme.css' | asset_url | stylesheet_tag }}
<style>:root{--str-one-img:url('{{ "str-one.jpg" | asset_url }}');--red:{{ settings.color_accent }};--cream:{{ settings.color_bg }};--greige:{{ settings.color_greige }}}</style>
<script>
window.ICHIGO_IMG={
  "str-bunch":"{{ 'str-bunch.jpg' | asset_url }}","str-farm":"{{ 'str-farm.jpg' | asset_url }}",
  "str-red":"{{ 'str-red.jpg' | asset_url }}","str-one":"{{ 'str-one.jpg' | asset_url }}",
  "str-hold":"{{ 'str-hold.jpg' | asset_url }}","hold-bunch":"{{ 'hold-bunch.jpg' | asset_url }}",
  "hold-plant":"{{ 'hold-plant.jpg' | asset_url }}","hold-box":"{{ 'hold-box.jpg' | asset_url }}",
  "hand-berry":"{{ 'hand-berry.jpg' | asset_url }}"
};
(function(d){d.documentElement.classList.add('reveal-js');setTimeout(function(){var n=d.querySelectorAll('[data-reveal]:not(.in)');for(var i=0;i<n.length;i++)n[i].classList.add('in')},4000)})(document);
</script>
{{ content_for_header }}
</head>
<body>
{{ content_for_layout }}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
